# Copy to .env and fill in the values. .env is gitignored; this file is not.
# The validation notebooks read these via python-dotenv when running locally,
# and fall back to Kaggle Secrets when running on Kaggle (see note at the bottom).

# --- Supabase / PostgreSQL (schema `bronze`) -----------------------------------
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<anon/publishable key>
SUPABASE_SECRET_KEY=<service-role/secret key>
SUPABASE_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json

# Full pooler connection string. Used by notebook 08 for the validation report.
SUPABASE_DB_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Optional: only needed if you prefer supplying the parts instead of SUPABASE_DB_URL.
# SUPABASE_DB_PASSWORD=<db-password>
# SUPABASE_DB_USER=postgres.<project-ref>
# SUPABASE_DB_HOST=aws-0-<region>.pooler.supabase.com
# SUPABASE_DB_PORT=5432
# SUPABASE_DB_NAME=postgres

# --- Cloudflare R2 (video/export storage) -------------------------------------
R2_ACCESS_KEY_ID=<access key id>
R2_SECRET_ACCESS_KEY=<secret access key>
R2_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
R2_BUCKET=<bucket name>
R2_PUBLIC_URL=https://<public bucket domain>

# --- LLM judge (validation notebook 08) ---------------------------------------
# The judge backend follows the operating system: Apple Silicon macOS runs the model
# locally with MLX, everything else (Kaggle included) calls Groq. On macOS no key is needed.
# Force one with JUDGE_BACKEND=mlx or JUDGE_BACKEND=groq.
# JUDGE_BACKEND=auto

# Needed only for the Groq backend.
GROQ_API_KEY=<groq api key>

# Optional model overrides; these are the defaults.
# GROQ_MODEL=openai/gpt-oss-120b
# MLX_JUDGE_MODEL=mlx-community/Qwen3-8B-4bit
# Smaller local judges were measured and are not reliable for this comparison; Qwen3-0.6B-8bit
# marked every activity in a video as covered. Keep the 8B unless you are only smoke-testing.

# --- Running on Kaggle --------------------------------------------------------
# Kaggle has no .env. Create these two Kaggle Secrets instead (Add-ons > Secrets):
#   DB_PASSWORD  -> the Supabase database password
#   groq         -> the Groq API key
# The notebook checks env vars first, then Kaggle Secrets, so the same code runs in both places.
